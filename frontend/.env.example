# Production / deployed frontend — point to your live API
# VITE_API_URL=https://your-api.example.com/api

# Dev: npm run dev auto-writes .env.local with your LAN IP for mobile QR scans.
# Manual override if auto-detect picks the wrong network adapter:
# VITE_PUBLIC_URL=http://192.168.1.10:5173

# Spring Boot port (used by Vite proxy only; default 8081)
# VITE_API_PROXY_TARGET=http://127.0.0.1:8081
